<?xml version="1.0"?>
<!--
  tiny_arm.xml - self-authored, MIT-clean MuJoCo test fixture.

  A two-hinge arm on a free base, built from MuJoCo primitives only: no
  mesh, texture, heightfield, include, or network reference.  The model is
  original to this repository and MIT-licensed (see tests/_support/data/
  README.md for provenance and the intended consumers).

  `compiler angle="radian"` is explicit: MuJoCo defaults to degrees, and the
  joint/limit tests assert the radian values declared below.

  Compiled order: joints shoulder, elbow; actuators shoulder_motor,
  elbow_motor; bodies world, base, link, tip.
-->
<mujoco model="tiny_arm">
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>
  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1"/>
    <body name="base" pos="0 0 0.8">
      <freejoint name="root"/>
      <geom name="base_geom" type="box" size="0.08 0.08 0.08" mass="2.0"/>
      <body name="link" pos="0 0 -0.16">
        <joint name="shoulder" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
        <geom name="link_geom" type="capsule" fromto="0 0 0 0 0 -0.3" size="0.04" mass="1.0"/>
        <body name="tip" pos="0 0 -0.3">
          <joint name="elbow" type="hinge" axis="0 1 0" range="-0.5 1.0"/>
          <geom name="tip_geom" type="capsule" fromto="0 0 0 0 0 -0.2" size="0.03" mass="0.5"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="shoulder_motor" joint="shoulder" ctrlrange="-20 20"/>
    <motor name="elbow_motor" joint="elbow" ctrlrange="-10 10"/>
  </actuator>
</mujoco>
